    {
      "id": "vllm_sosp23",
      "title": "Efficient Memory Management for Large Language Model Serving with PagedAttention",
      "titleZh": "vLLM：用 PagedAttention 重构大模型推理的显存管理",
      "venue": "SOSP 2023",
      "year": 2023,
      "topic": "inference_runtime",
      "status": "顶会论文 · 领域奠基",
      "url": "https://dl.acm.org/doi/10.1145/3600006.3613165",
      "codeUrl": "https://github.com/vllm-project/vllm",
      "oneSentenceZh": "把 KV Cache 切成可按需映射的块，减少显存碎片和重复占用，成为现代 LLM Serving 的基础内存抽象。",
      "whyItMattersZh": "后续连续批处理、调度和 KV Cache 分层工作大多以它为系统基线，虽然超出两年窗口，仍作为著名论文保留。",
      "famousException": true,
      "latestUpdatedAt": "2026-08-02T19:59:39.362000+00:00",
      "versionCount": 1,
      "latestChange": "unknown",
      "interpretations": []
    },
    {
      "id": "sarathi_serve_osdi24",
      "title": "Taming Throughput-Latency Tradeoff in LLM Inference with Sarathi-Serve",
      "titleZh": "Sarathi-Serve：用分块 Prefill 缓和吞吐与时延冲突",
      "venue": "OSDI 2024",
      "year": 2024,
      "topic": "inference_scheduling",
      "status": "顶会论文",
      "url": "https://www.usenix.org/conference/osdi24/presentation/agrawal",
      "codeUrl": "https://github.com/microsoft/sarathi-serve",
      "oneSentenceZh": "将长 Prefill 切块并与 Decode 组成更均匀的批次，在不长时间阻塞解码的前提下提高 GPU 利用率。",
      "whyItMattersZh": "它直接对应动态负载下的推理调度，是分析功率预算变化时如何调整批次和阶段执行的重要基线。",
      "famousException": false,
      "latestUpdatedAt": null,
      "versionCount": 0,
      "latestChange": null,
      "interpretations": []
    },
    {
      "id": "infinigen_osdi24",
      "title": "InfiniGen: Efficient Generative Inference of Large Language Models with Dynamic KV Cache Management",
      "titleZh": "InfiniGen：只预取下一步真正需要的 KV Cache",
      "venue": "OSDI 2024",
      "year": 2024,
      "topic": "kv_cache",
      "status": "顶会论文",
      "url": "https://www.usenix.org/conference/osdi24/presentation/lee",
      "codeUrl": null,
      "oneSentenceZh": "通过轻量预演预测下一层需要关注的 token，只从主机侧预取关键 KV 条目，降低卸载式推理的数据搬运。",
      "whyItMattersZh": "对存储和带宽受限平台尤其有参考价值，核心问题是以少量额外计算换取更低的 KV 传输压力。",
      "famousException": false,
      "latestUpdatedAt": null,
      "versionCount": 0,
